@{
    var page = ViewContext.RouteData.Values["action"]?.ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TM Visuals</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm tm-navbar">
            <div class="container-fluid">
                <a class="navbar-brand tm-logo" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="TM Visuals" class="tm-logo-img" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <!-- Left links -->
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link @(page == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(page == "Services" ? "active" : "")" asp-controller="Home" asp-action="Services">Services</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(page == "MyWork" ? "active" : "")" asp-controller="Home" asp-action="MyWork">My Work</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controller == "Booking" ? "active" : "")" asp-controller="Booking" asp-action="CreateBooking">Booking</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(page == "Profile" ? "active" : "")" asp-controller="Home" asp-action="Profile">Profile</a>
                        </li>
                    </ul>

                    <!-- Right links (login state) -->
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="nav-auth-form">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="nav-auth-button">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link @(page == "Login" ? "active" : "")" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(page == "Register" ? "active" : "")" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    @if (controller != "Account")
    {
        <footer class="tm-footer">
            <div class="footer-copy">
                @@2026 -<br />Copyright All<br />Rights<br />Reserved
            </div>

            <div class="footer-social">
                <div class="footer-icons">
                    <a href="https://wa.me/27812345678" class="icon-whatsapp" aria-label="WhatsApp"><i class="fa-brands fa-whatsapp"></i></a>
                    <a href="mailto:tmvisuals@gmail.com" class="icon-mail" aria-label="Email"><i class="fa-solid fa-envelope"></i></a>
                    <a href="#" class="icon-tiktok" aria-label="TikTok"><i class="fa-brands fa-tiktok"></i></a>
                    <a href="#" class="icon-instagram" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
                </div>
                <p class="footer-disclaimer">Disclaimer: Bookings have 50% deposit</p>
            </div>

            <div class="footer-contact">
                Contact Us<br />0812345678
            </div>

            <div class="footer-brand">
                <img src="~/images/logo.png" alt="TM Visuals" class="footer-logo-img" />
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
