@model List<TMVisualsWebApp.Models.PortfolioItem>
@{
    ViewData["Title"] = "Portfolio";
    var categories = Model
        .Select(item => item.Category.Trim())
        .Where(category => category.Length > 0)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(category => category)
        .ToList();
}

<div class="work-page">
    <section class="work-hero">
        <h1 class="main-title">Our Work in Three Words</h1>
        <hr class="work-divider" />
        <div class="three-cards">
            <article class="work-card">
                <h2>Storytelling</h2>
                <p>Every frame is composed to capture the genuine atmosphere and story of your day.</p>
            </article>
            <article class="work-card work-card-highlight">
                <h2>High quality</h2>
                <p>Beautifully edited photos and videos, polished and ready to share.</p>
            </article>
            <article class="work-card">
                <h2>Variety</h2>
                <p>From wide room views to intimate moments, we capture the details that matter.</p>
            </article>
        </div>
    </section>

    <section class="selected-work">
        <h2>Portfolio</h2>
        <div class="portfolio-filters" data-portfolio-filters aria-label="Filter portfolio by category">
            <button type="button"
                    class="portfolio-filter is-active"
                    data-portfolio-filter="all"
                    aria-pressed="true">
                All
            </button>
            @foreach (var category in categories)
            {
                <button type="button"
                        class="portfolio-filter"
                        data-portfolio-filter="@category"
                        aria-pressed="false">
                    @category
                </button>
            }
        </div>
        @if (ViewData["PortfolioError"] is string portfolioError)
        {
            <p class="delivery-note" role="status">@portfolioError</p>
        }
        else if (Model.Count == 0)
        {
            <p class="delivery-note">New work will appear here when it is added to the portfolio.</p>
        }

        <div class="portfolio-items">
            @foreach (var item in Model)
            {
                <article class="portfolio-card" data-portfolio-category="@item.Category.Trim()">
                    <div class="portfolio-card-media">
                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            @if (string.Equals(item.MediaType, "video", StringComparison.OrdinalIgnoreCase))
                            {
                                <video controls preload="metadata" aria-label="@item.Title">
                                    <source src="@item.ImageUrl" />
                                </video>
                            }
                            else
                            {
                                <img src="@item.ImageUrl" alt="@item.Title" loading="lazy" />
                            }
                        }
                        else
                        {
                            <div class="portfolio-placeholder" aria-hidden="true">
                                @item.Category
                            </div>
                        }
                    </div>
                    <div class="portfolio-card-copy">
                        @if (!string.IsNullOrWhiteSpace(item.Category) &&
                             !string.Equals(item.Category, item.Title, StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="portfolio-category">@item.Category</span>
                        }
                        <h3>@item.Title</h3>
                        @if (!string.IsNullOrWhiteSpace(item.Description))
                        {
                            <p>@item.Description</p>
                        }
                    </div>
                </article>
            }
        </div>

        <p class="delivery-note">
            Private client delivery. Completed client content is delivered through private links and is never shown here.
        </p>
    </section>
</div>