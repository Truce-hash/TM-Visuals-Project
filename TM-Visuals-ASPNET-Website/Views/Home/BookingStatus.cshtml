@model TMVisualsWebApp.Models.Booking
@{
    ViewData["Title"] = "Booking Status";
}
<div class="booking-page">

    <div class="info-card">
        <h4>Booking Info</h4>
        <div class="info-row"><span>Name</span><span>@Model.Name</span></div>
        <div class="info-row"><span>Phone Number</span><span>@Model.Phone</span></div>
        <div class="info-row"><span>Email Address</span><span>@Model.Email</span></div>
        <div class="info-row"><span>Services</span><span>@Model.Service</span></div>
        <div class="info-row"><span>Type of Event</span><span>@Model.EventType</span></div>
        <div class="info-row"><span>Number of people</span><span>@Model.NumberOfPeople</span></div>
        <div class="info-row"><span>Location</span><span>@Model.Location</span></div>
        <div class="info-row"><span>Date</span><span>@Model.Date?.ToString("dd MMMM yyyy")</span></div>
        <div class="info-row"><span>Start Time</span><span>@Model.StartTime?.ToString(@"hh\:mm")</span></div>
        <div class="info-row"><span>Finish Time</span><span>@Model.FinishTime?.ToString(@"hh\:mm")</span></div>
    </div>

    <div class="status-row">
        <span>Booking Status</span>
        <span class="status-btn">@Model.Status</span>
    </div>

    <div class="action-row">
        @if (Model.Status != "Cancelled")
        {
            <button type="button" class="action-btn cancel" id="openCancel">Cancel booking</button>

            <dialog id="cancelDialog" class="confirm-dialog">
                <h3>Are you sure you want to cancel this booking?</h3>
                <p>The 50% deposit is non-refundable.</p>

                <form asp-controller="Home" asp-action="CancelBooking" asp-route-id="@Model.Id"
                      method="post" class="confirm-actions">
                    <button type="button" class="confirm-keep" id="keepBooking">No, keep booking</button>
                    <button type="submit" class="confirm-yes">Yes, cancel booking</button>
                </form>
            </dialog>
        }
        <a class="action-btn back" asp-controller="Home" asp-action="Profile">Back to My Profile</a>
    </div>

    <div class="disclaimer">
        Disclaimer: Bookings require a deposit which makes 50% of the total amount.
        This amount is not refunded when you cancel booking.
    </div>

</div>


@section Scripts {
    <script>
        const dlg = document.getElementById("cancelDialog");
        if (dlg) {
            document.getElementById("openCancel").addEventListener("click", function () {
                dlg.showModal();
            });
            document.getElementById("keepBooking").addEventListener("click", function () {
                dlg.close();
            });
            dlg.addEventListener("click", function (e) {
                if (e.target === dlg) dlg.close();
            });
        }
    </script>
}
