@model TMVisualsWebApp.Models.Account.LoginViewModel

@{
    ViewData["Title"] = "Login";
}
 
<div class="auth-page">
    <section class="auth-card auth-card-login" aria-labelledby="auth-title">
        <h1 id="auth-title" class="auth-title">Welcome Back</h1>

        @if (TempData["AuthMessage"] is string authMessage)
        {
            <p class="auth-status" role="status">@authMessage</p>
        }

        <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="auth-alert"></div>

            <div class="auth-field">
                <label asp-for="Email" class="auth-label"></label>
                <input asp-for="Email" class="auth-input" placeholder="youremail@example.com" autocomplete="email" />
                <span asp-validation-for="Email" class="auth-error"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Password" class="auth-label"></label>
                <div class="auth-password">
                    <input asp-for="Password" class="auth-input" placeholder="Your password" autocomplete="current-password" />
                    <button type="button" class="auth-toggle" data-toggle-password aria-label="Show or hide password">Show</button>
                </div>
                <span asp-validation-for="Password" class="auth-error"></span>
            </div>

            <p class="auth-forgot">
                <a asp-controller="Account" asp-action="ForgotPassword">Forgot password?</a>
            </p>

            <div class="auth-check">
                <input asp-for="RememberMe" class="auth-checkbox" />
                <label asp-for="RememberMe" class="auth-check-label"></label>
            </div>

            <button type="submit" class="auth-button">Login</button>
        </form>

        <div class="auth-divider"><span>or</span></div>
        <partial name="_GoogleSignInButton" />

        <p class="auth-switch">
            Don't have an account?
            <a asp-controller="Account" asp-action="Register">Register</a>
        </p>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}