@model TMVisualsWebApp.Models.Account.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot password";
}

<div class="auth-page">
    <section class="auth-card auth-card-compact" aria-labelledby="auth-title">
        <h1 id="auth-title" class="auth-title">Reset your password</h1>
        <p class="auth-description">Enter your email and we’ll send a password reset link if an account exists.</p>

        @if (TempData["AuthMessage"] is string authMessage)
        {
            <p class="auth-status" role="status">@authMessage</p>
        }

        <form asp-controller="Account" asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="auth-alert" role="alert"></div>
            <div class="auth-field">
                <label asp-for="Email" class="auth-label"></label>
                <input asp-for="Email" class="auth-input" placeholder="youremail@example.com" autocomplete="email" />
                <span asp-validation-for="Email" class="auth-error"></span>
            </div>
            <button type="submit" class="auth-button">Send reset link</button>
        </form>

        <p class="auth-switch">
            Remember your password?
            <a asp-controller="Account" asp-action="Login">Back to login</a>
        </p>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
