@model TMVisualsWebApp.Models.Account.ResetPasswordViewModel

@{
    ViewData["Title"] = "Choose a new password";
}

<div class="auth-page">
    <section class="auth-card auth-card-compact" aria-labelledby="auth-title">
        <h1 id="auth-title" class="auth-title">Choose a new password</h1>
        <p id="reset-link-status" class="auth-description" role="status">
            Checking your reset link…
        </p>

        <form id="reset-password-form"
              asp-controller="Account"
              asp-action="ResetPassword"
              method="post"
              hidden>
            @Html.AntiForgeryToken()
            <input asp-for="AccessToken" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="auth-alert" role="alert"></div>
            <div class="auth-field">
                <label asp-for="Password" class="auth-label"></label>
                <input asp-for="Password" class="auth-input" autocomplete="new-password" />
                <span class="auth-hint">Use at least 8 characters.</span>
                <span asp-validation-for="Password" class="auth-error"></span>
            </div>
            <div class="auth-field">
                <label asp-for="ConfirmPassword" class="auth-label"></label>
                <input asp-for="ConfirmPassword" class="auth-input" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="auth-error"></span>
            </div>
            <button type="submit" class="auth-button">Update password</button>
        </form>

        <p class="auth-switch">
            <a asp-controller="Account" asp-action="ForgotPassword">Request another reset link</a>
        </p>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var tokenInput = document.getElementById('AccessToken');
            var form = document.getElementById('reset-password-form');
            var status = document.getElementById('reset-link-status');
            var token = tokenInput.value;
            var parameters = new URLSearchParams(window.location.hash.substring(1));

            if (!token && parameters.get('type') === 'recovery') {
                token = parameters.get('access_token') || '';
                tokenInput.value = token;
            }

            if (window.location.hash) {
                window.history.replaceState(
                    null,
                    document.title,
                    window.location.pathname + window.location.search);
            }

            if (!token) {
                status.textContent = 'This reset link is invalid or expired. Request a new one to continue.';
                return;
            }

            status.textContent = 'Enter and confirm your new password.';
            form.hidden = false;
        })();
    </script>
}
